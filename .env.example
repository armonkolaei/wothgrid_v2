# MongoDB-compatible Firestore connection string (server-side only; never prefix with VITE_)
MONGODB_URI=
MONGODB_DB=worthgrid-db
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Encrypts stored broker tokens: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes saved connections unreadable (users must reconnect).
ENCRYPTION_KEY=
# Protects the daily sync endpoint; Vercel Cron sends it automatically: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
